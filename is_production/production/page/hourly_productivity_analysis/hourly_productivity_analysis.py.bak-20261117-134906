CATEGORIES = ("green", "amber", "red", "grey")


def validate_range(from_date, to_date):
    start, end = getdate(from_date), getdate(to_date)
    if start > end:
        raise ValueError("From Date must be on or before To Date")
    if (end - start).days >= 366:
        raise ValueError("Select at most 366 operational days")
    return start, end


def category(hour):
    target, actual = hour["target_bcm"], hour["actual_bcm"]
    if target is None:
        raise ValueError("Hourly target is unavailable; a covering MPP is required")
    if target == 0:
        return "red"  # No deployed machines does not prove a scheduled non-working period.
    # target_bcm already includes all MPP production excavators.
    # Green = 220 BCM per excavator; Orange = 200 BCM per excavator.
    # Preserve proportional thresholds for partial hours.
    if actual >= target:
        return "green"
    if actual >= target * (200 / 220):
        return "amber"
    return "red"



def get_average_productive_hours(target_bcm, production_excavators,
                                 excluded_minutes=0, *, verified=True):
    """Convert weighted hourly targets into effective productive hours."""
    if not verified:
        return None

    try:
        target = float(target_bcm)
        excavators = float(production_excavators)
        excluded = float(excluded_minutes or 0)
    except (TypeError, ValueError):
        return None

    if (
        not all(isfinite(value) for value in (target, excavators, excluded))
        or target < 0 or excavators <= 0 or excluded < 0
    ):
        return None

    # Full production target: 220 BCM per excavator per productive hour.
    weighted_hours = target / (excavators * 220)

    # Remove fatigue/non-working time. Never allow negative productive hours.
    return max(0.0, weighted_hours - excluded / 60)


def planning_error(first, last, site, plans, *, permission_denied=False):
    """Only inspect accessible plans; never probe for hidden record existence."""
    months = {}
    for offset in range((last - first).days + 1):
        date = first + timedelta(days=offset)
        if permission_denied or summary.select_plan(plans, site, date) is None:
            months.setdefault(date.strftime("%Y-%m"), date.strftime("%B %Y"))
    if not months:
        return None
    issues = []
    for key, month in months.items():
        message = (f"You do not have permission to access Monthly Production Planning for {site} for {month}. "
                   "Please ask your administrator for access." if permission_denied else
                   f"No accessible production plan was found for {site} for {month}. Please check that the "
                   "Monthly Production Planning exists and that you have permission to access it.")
        issues.append({"month_key": key, "month": month, "status": "permission_denied" if permission_denied
                       else "missing_or_inaccessible", "message": message})
    return {"rows": [], "planning_error": {
        "title": "Monthly Production Planning Access Denied" if permission_denied
                 else "Monthly Production Planning Not Found", "issues": issues}}


def _schedule_document(doctype, name, fields):
    doc = frappe.get_doc(doctype, name)
    doc.check_permission("read")
    before = doc.as_dict()
    doc.apply_fieldlevel_read_permissions()
    result = doc.as_dict()
    if any(before.get(field) != result.get(field) for field in fields):
        raise frappe.PermissionError("Access to scheduling calculation fields is required")
    return result


def load_plans(site, first, last):
    summary._read_document("Location", site)
    if not frappe.has_permission("Monthly Production Planning", "read"):
        return None
    fields = ("location", "prod_month_start_date", "prod_month_end_date", "num_excavators",
              "excavator_truck_assignments", "excluded_production_machines", "month_prod_days", "month_actual_bcm")
    plans = []
    for row in summary._permitted_rows("Monthly Production Planning", {
            "location": site, "prod_month_start_date": ["<=", last],
            "prod_month_end_date": [">=", first], "docstatus": ["<", 2]},
            order_by="modified desc, name desc"):
        try:
            plans.append(_schedule_document("Monthly Production Planning", row.name, fields))
        except frappe.PermissionError:
            # A list-visible plan may still deny document or scheduling-field access.
            # Keep readable months and report uncovered months without revealing this record.
            continue
    return plans


def load_fatigue(site):
    return summary.load_fatigue(site)


def non_working_windows(plan, date, shift, site, fatigue, warnings):
    return shift_windows(plan, date, shift, site, fatigue, warnings)[0]



def mpp_adt_scope(plan, machine_scope):
    """Resolve saved MPP ADT assignments for one operational date."""
    if machine_scope not in ("all", "production", "spare"):
        raise ValueError("Invalid machine scope")

    production = set()
    spare = set()

    for row in plan.get("excavator_truck_assignments", []):
        truck = row.get("truck")
        if not truck:
            continue

        if row.get("excavator"):
            production.add(truck)
        else:
            spare.add(truck)

    # Conflicting assignments cannot safely be classified.
    ambiguous = production & spare
    production -= ambiguous
    spare -= ambiguous

    if machine_scope == "all":
        return production | spare
    return production if machine_scope == "production" else spare







def mpp_production_adt_roster(plan):
    """Resolve a complete, unambiguous production ADT roster from saved MPP."""
    assignments = plan.get("excavator_truck_assignments")
    if assignments is None:
        return None

    production = set()
    spare = set()
    production_excavators = set()
    truck_owners = {}

    for row in assignments:
        excavator = row.get("excavator")
        truck = row.get("truck")

        if not truck:
            continue

        if excavator:
            production.add(truck)
            production_excavators.add(excavator)
            truck_owners.setdefault(truck, set()).add(excavator)
        else:
            spare.add(truck)

    if production & spare:
        return None

    if any(len(owners) > 1 for owners in truck_owners.values()):
        return None

    try:
        count = float(plan.get("num_excavators"))
    except (TypeError, ValueError):
        return None

    if not isfinite(count) or not count.is_integer() or count < 0:
        return None

    if int(count) != len(production_excavators):
        return None

    return production or None



def production_adt_availability_segments(
    production_adts, assets, breakdowns, start, end, now
):
    """Calculate two exact, time-weighted 30-minute ADT availability blocks."""
    start = get_datetime(start)
    end = get_datetime(end)
    now = get_datetime(now)

    def unknown_segment(left=0, right=60):
        return [{
            "start_minute": left,
            "end_minute": right,
            "category": "unknown",
            "available": None,
            "unavailable": None,
            "unknown": True,
        }]

    if not production_adts or end <= start:
        return unknown_segment()

    assets_by_name = {row["name"]: row for row in assets}
    aliases = {
        alias: row["name"]
        for row in assets
        for alias in (row.get("name"), row.get("asset_name"))
        if alias
    }

    if any(
        asset not in assets_by_name
        or assets_by_name[asset].get("asset_category") != "ADT"
        for asset in production_adts
    ):
        return unknown_segment()

    events = {asset: [] for asset in production_adts}

    for row in breakdowns:
        # This highlighting is specifically for production ADT breakdowns.
        if row.get("downtime_type") != "Breakdown":
            continue

        asset = aliases.get(row.get("asset_name"))
        if asset not in production_adts:
            continue

        if not row.get("breakdown_start_datetime"):
            continue

        try:
            event_start = get_datetime(row["breakdown_start_datetime"])
            status = str(row.get("open_closed") or "").strip().lower()
            resolved = row.get("resolved_datetime")

            if status == "open":
                event_end = now
                uncertain = False
            elif status == "closed" and resolved:
                event_end = get_datetime(resolved)
                uncertain = False
            elif resolved:
                event_end = get_datetime(resolved)
                uncertain = True
            else:
                event_end = now
                uncertain = True

            event_end = min(event_end, now)
        except (TypeError, ValueError):
            continue

        if event_end <= event_start:
            continue

        events[asset].append({
            "start": event_start,
            "end": event_end,
            "uncertain": uncertain,
        })

    def union_seconds(intervals, left, right):
        """Union overlapping PBM intervals so one ADT is never double-counted."""
        clipped = sorted(
            (max(left, a), min(right, b))
            for a, b in intervals
            if a < right and b > left
        )

        if not clipped:
            return 0.0

        total = 0.0
        current_start, current_end = clipped[0]

        for next_start, next_end in clipped[1:]:
            if next_start <= current_end:
                current_end = max(current_end, next_end)
            else:
                total += (current_end - current_start).total_seconds()
                current_start, current_end = next_start, next_end

        total += (current_end - current_start).total_seconds()
        return total

    segments = []
    fleet_total = len(production_adts)

    for half in range(2):
        block_start = start + timedelta(minutes=half * 30)
        block_end = min(block_start + timedelta(minutes=30), end)
        known_end = min(block_end, now)
        offset = half * 30
        block_offset_end = (block_end - start).total_seconds() / 60

        if block_start >= now or known_end <= block_start:
            segments.extend(unknown_segment(offset, block_offset_end))
            continue

        boundaries = {block_start, known_end}

        for asset in production_adts:
            for event in events[asset]:
                if event["start"] < known_end and event["end"] > block_start:
                    boundaries.add(max(block_start, event["start"]))
                    boundaries.add(min(known_end, event["end"]))

        ordered = sorted(boundaries)
        maximum_unavailable = 0
        has_unknown = False

        for left, right in zip(ordered, ordered[1:]):
            if right <= left:
                continue

            unavailable_ids = set()
            unknown_ids = set()

            for asset in production_adts:
                active = [
                    event for event in events[asset]
                    if event["start"] <= left < event["end"]
                ]

                if any(not event["uncertain"] for event in active):
                    unavailable_ids.add(asset)
                elif active:
                    unknown_ids.add(asset)

            maximum_unavailable = max(
                maximum_unavailable, len(unavailable_ids)
            )
            has_unknown = has_unknown or bool(unknown_ids)

        # Classify by the maximum simultaneous unavailable fleet count.
        if maximum_unavailable >= 2:
            category = "red"
        elif has_unknown:
            category = "unknown"
        elif maximum_unavailable == 1:
            category = "orange"
        else:
            category = "green"

        segments.append({
            "start_minute": offset,
            "end_minute": (known_end - start).total_seconds() / 60,
            "category": category,
            "available": (
                fleet_total - maximum_unavailable if not has_unknown else None
            ),
            "unavailable": maximum_unavailable,
            "unknown": has_unknown,
        })

        # Never classify the unelapsed part of the current half-hour.
        if known_end < block_end:
            segments.extend(unknown_segment(
                (known_end - start).total_seconds() / 60,
                block_offset_end,
            ))

    return segments or unknown_segment()



def mpp_excavator_roster(plan):
    """Return unique production and spare excavators from MPP."""
    assignments = plan.get("excavator_truck_assignments")
    if assignments is None:
        return None

    excluded = {
        row.get("asset")
        for row in (plan.get("excluded_production_machines") or [])
        if row.get("machine_type") == "Excavator" and row.get("asset")
    }

    return {
        row.get("excavator")
        for row in assignments
        if row.get("excavator")
    } - excluded


def excavator_availability_category(unavailable, verified=True):
    if not verified:
        return "unknown"
    if unavailable == 0:
        return "green"
    if unavailable == 1:
        return "orange"
    return "red"




def load_excavator_pbm(site, start, end, assets):
    """Load permitted Breakdown and Planned Maintenance records, including A&U exclusions."""
    aliases = sorted({
        value
        for asset in assets
        for value in (asset.get("name"), asset.get("asset_name"))
        if value
    })
    if not aliases:
        return []

    names = summary._permitted_rows(
        "Plant Breakdown or Maintenance",
        {
            "location": site,
            "asset_name": ["in", aliases],
            "downtime_type": ["in", ["Breakdown", "Planned Maintenance"]],
            "docstatus": ["<", 2],
            "breakdown_start_datetime": ["<", end],
        },
        order_by="breakdown_start_datetime asc",
        or_filters=[
            ["resolved_datetime", ">", start],
            ["open_closed", "=", "Open"],
            ["resolved_datetime", "is", "not set"],
        ],
    )

    required_fields = (
        "location", "asset_name", "downtime_type",
        "breakdown_start_datetime", "resolved_datetime",
        "open_closed", "breakdown_reason", "resolution_summary",
        "exclude_from_au", "docstatus",
    )

    records = []
    for row in names:
        doc = frappe.get_doc("Plant Breakdown or Maintenance", row.name)
        doc.check_permission("read")
        before = doc.as_dict()
        doc.apply_fieldlevel_read_permissions()
        after = doc.as_dict()

        if any(before.get(field) != after.get(field) for field in required_fields):
            raise frappe.PermissionError(
                "Read access to Plant Breakdown or Maintenance calculation fields is required"
            )

        records.append(after)

    return records


def build_excavator_availability(
    from_date, to_date, site, plans, assets, breakdowns, documents, *, now=None
):
    """Build exact minute-level availability timelines for the MPP excavator fleet."""
    first, last = validate_range(from_date, to_date)
    error = planning_error(first, last, site, plans)
    if error:
        return error

    now = get_datetime(now or now_datetime())
    start = datetime.combine(first, time(6))
    end = datetime.combine(last + timedelta(days=1), time(6))

    assets_by_name = {row["name"]: row for row in assets}
    aliases = {
        alias: row["name"]
        for row in assets
        for alias in (row.get("name"), row.get("asset_name"))
        if alias
    }

    events_by_asset = defaultdict(list)
    invalid_pbm = 0

    for row in breakdowns:
        asset = aliases.get(row.get("asset_name"))
        if not asset or not row.get("breakdown_start_datetime"):
            invalid_pbm += 1
            continue

        event_start = get_datetime(row["breakdown_start_datetime"])
        status = str(row.get("open_closed") or "").strip().lower()
        resolved = row.get("resolved_datetime")
        uncertain = False

        if status == "open":
            event_end = now
        elif status == "closed" and resolved:
            event_end = get_datetime(resolved)
        elif resolved:
            event_end = get_datetime(resolved)
            uncertain = True
        else:
            # A closed/unknown record without a resolution time cannot prove
            # when the machine became available again.
            event_end = now
            uncertain = True

        event_end = min(event_end, now)

        if event_end <= event_start or event_start >= end or event_end <= start:
            continue

        events_by_asset[asset].append({
            "start": event_start,
            "end": event_end,
            "uncertain": uncertain,
            "details": {
                "downtime_type": row.get("downtime_type") or "Downtime",
                "status": row.get("open_closed") or "Unknown",
                "reason": row.get("breakdown_reason") or "Reason not recorded",
                "resolution": row.get("resolution_summary") or "",
                "start": event_start.isoformat(sep=" "),
                "resolved": get_datetime(resolved).isoformat(sep=" ") if resolved else None,
                "effective_end": event_end.isoformat(sep=" "),
                "exclude_from_au": bool(row.get("exclude_from_au")),
            },
        })

    recorded_by_date = defaultdict(set)
    seen_documents = set()

    for doc in documents:
        if doc.get("location") != site or doc.get("docstatus", 0) >= 2:
            continue
        if doc.get("name") in seen_documents:
            continue
        seen_documents.add(doc.get("name"))

        try:
            dt = source_hour(doc["prod_date"], doc["hour_slot"])
            if doc.get("shift") == "Night" and dt.hour < 6:
                dt += timedelta(days=1)
            operational_date = (dt - timedelta(hours=6)).date()
        except (ValueError, TypeError, KeyError):
            continue

        if first <= operational_date <= last:
            recorded_by_date[operational_date].add(dt)

    rows = []
    missing = pending = 0

    for offset in range((last - first).days + 1):
        date = first + timedelta(days=offset)
        plan = summary.select_plan(plans, site, date)
        excavators = mpp_excavator_roster(plan)

        if not excavators:
            return {"rows": [], "configuration_error": {
                "title": "Excavator Fleet Unavailable",
                "message": f"No complete excavator roster found for {date}."
            }}

        invalid = [
            asset for asset in excavators
            if asset not in assets_by_name
            or assets_by_name[asset].get("asset_category") != "Excavator"
        ]
        if invalid:
            return {"rows": [], "configuration_error": {
                "title": "Excavator Asset Access Required",
                "message": f"Unable to verify the complete excavator roster for {date}."
            }}

        total = len(excavators)
        cells = []
        day_start = datetime.combine(date, time(6))

        for index in range(24):
            left = day_start + timedelta(hours=index)
            right = left + timedelta(hours=1)
            completed = right <= now
            has_record = left in recorded_by_date[date]

            machine_events = {}
            boundaries = {left, right}

            for asset in excavators:
                overlaps = [
                    event for event in events_by_asset.get(asset, [])
                    if event["start"] < right and event["end"] > left
                ]
                machine_events[asset] = overlaps

                for event in overlaps:
                    boundaries.add(max(left, event["start"]))
                    boundaries.add(min(right, event["end"]))

            if left < now < right:
                boundaries.add(now)

            ordered = sorted(boundaries)
            segments = []

            for segment_start, segment_end in zip(ordered, ordered[1:]):
                unavailable_ids = []
                unknown_ids = []

                for asset in excavators:
                    active = [
                        event for event in machine_events[asset]
                        if event["start"] <= segment_start < event["end"]
                    ]

                    if any(not event["uncertain"] for event in active):
                        unavailable_ids.append(asset)
                    elif active or segment_start >= now or not has_record:
                        unknown_ids.append(asset)

                unavailable_count = len(unavailable_ids)
                unknown_count = len(unknown_ids)

                if unavailable_count >= 2:
                    category = "red"
                elif unknown_count:
                    category = "unknown"
                elif unavailable_count == 1:
                    category = "orange"
                else:
                    category = "green"

                segments.append({
                    "start_minute": (segment_start - left).total_seconds() / 60,
                    "end_minute": (segment_end - left).total_seconds() / 60,
                    "category": category,
                    "unavailable": unavailable_count,
                    "unknown": unknown_count,
                    "available": total - unavailable_count if not unknown_count else None,
                    "unavailable_excavators": [
                        assets_by_name[a].get("asset_name") or a
                        for a in unavailable_ids
                    ],
                })

            details = []
            for asset in sorted(excavators):
                overlaps = machine_events[asset]
                known_down = any(not event["uncertain"] for event in overlaps)
                uncertain_down = any(event["uncertain"] for event in overlaps)

                if known_down:
                    machine_status = "Unavailable"
                elif uncertain_down or not has_record or not completed:
                    machine_status = "Unverified"
                else:
                    machine_status = "Available"

                details.append({
                    "asset": asset,
                    "label": assets_by_name[asset].get("asset_name") or asset,
                    "status": machine_status,
                    "events": [event["details"] for event in overlaps],
                })

            known_segments = [segment for segment in segments if segment["available"] is not None]
            worst_categories = [segment["category"] for segment in segments]

            if "red" in worst_categories:
                overall_category = "red"
            elif "orange" in worst_categories:
                overall_category = "orange"
            elif known_segments:
                overall_category = "green"
            else:
                overall_category = "unknown"

            if not completed:
                pending += 1
            elif not has_record:
                missing += 1

            cells.append({
                "label": f"{left:%H}:00-{(left.hour + 1) % 24:02}:00",
                "completed": completed,
                "has_record": has_record,
                "available": min(s["available"] for s in known_segments) if known_segments else None,
                "unavailable": max((s["unavailable"] for s in segments), default=0),
                "category": overall_category,
                "segments": segments,
                "details": details,
            })

        rows.append({
            "date": date.isoformat(),
            "day": date.strftime("%a"),
            "month": date.strftime("%B %Y"),
            "month_key": date.strftime("%Y-%m"),
            "fleet_total": total,
            "cells": cells,
        })

    warnings = []
    if missing:
        warnings.append(f"{missing} completed hours have no Hourly Production record.")
    if pending:
        warnings.append(f"{pending} hours are unfinished or future.")
    if invalid_pbm:
        warnings.append(f"{invalid_pbm} PBM records could not be matched to an excavator.")

    return {
        "site": site,
        "from_date": first.isoformat(),
        "to_date": last.isoformat(),
        "hours": [cell["label"] for cell in rows[0]["cells"]],
        "rows": rows,
        "missing_hours": missing,
        "pending_hours": pending,
        "warnings": warnings,
    }


def get_mpp_daily_target(plan, date):
    """Read the authoritative saved daily target from Monthly Production Days."""
    matching = [
        row for row in (plan.get("month_prod_days") or [])
        if row.get("shift_start_date")
        and getdate(row["shift_start_date"]) == date
    ]

    if len(matching) != 1:
        return None

    value = matching[0].get("bcm_per_day")

    try:
        target = float(value)
    except (TypeError, ValueError):
        return None

    if not isfinite(target) or target < 0:
        return None

    return target



def get_mpp_month_actual(plan):
    """Read saved Monthly Actual BCMs from Monthly Production Planning."""
    value = plan.get("month_actual_bcm")
    try:
        actual = float(value)
    except (TypeError, ValueError):
        return None
    return actual if isfinite(actual) and actual >= 0 else None


def build_analysis(from_date, to_date, site, plans, assets, breakdowns, documents, *, now=None, fatigue=(), machine_scope="all", include_machine_targets=False, availability_breakdowns=None):
    first, last = validate_range(from_date, to_date)
    error = planning_error(first, last, site, plans)
    if error:
        return error
    # Never turn a missing saved production count into a zero BCM threshold.
    # The machine tab has its own MPP ADT roster and does not use BCM colours.
    if not include_machine_targets:
        for offset in range((last - first).days + 1):
            date = first + timedelta(days=offset)
            plan = summary.select_plan(plans, site, date)
            raw_count = plan.get("num_excavators")
            try:
                count = float(raw_count) if raw_count not in (None, "") else None
            except (TypeError, ValueError):
                count = None
            if count is None or not isfinite(count) or count < 0 or not count.is_integer():
                return {"rows": [], "configuration_error": {
                    "title": "Production Excavator Count Unavailable",
                    "message": f"MPP production excavator count is missing or invalid for {date}. "
                               "Check the saved Number of Production Excavators before classifying BCM hours."}}
    now = get_datetime(now or now_datetime())
    availability_breakdowns = breakdowns if availability_breakdowns is None else availability_breakdowns
    by_date = defaultdict(list)
    warnings = []
    seen = set()
    for doc in documents:
        if doc.get("location") != site or doc.get("docstatus", 0) >= 2 or doc["name"] in seen:
            continue
        seen.add(doc["name"])
        try:
            dt = source_hour(doc["prod_date"], doc["hour_slot"])
            if doc.get("shift") == "Night" and dt.hour < 6:
                dt += timedelta(days=1)
            operational_date = (dt - timedelta(hours=6)).date()
        except (ValueError, TypeError):
            warnings.append("An invalid source hour was excluded.")
            continue
        if first <= operational_date <= last:
            by_date[operational_date].append(doc)
    rows = []
    counts = dict.fromkeys(CATEGORIES, 0)
    missing = pending = 0
    for offset in range((last - first).days + 1):
        date = first + timedelta(days=offset)
        plan = summary.select_plan(plans, site, date)

        mpp_daily_target = (
            None if include_machine_targets
            else get_mpp_daily_target(plan, date)
        )

        if not include_machine_targets and mpp_daily_target is None:
            warnings.append(
                f"MPP daily target unavailable for {date}; "
                "check Monthly Production Days."
            )

        adt_scope = mpp_adt_scope(plan, machine_scope)
        fleet_total = len(adt_scope)
        production_scope = mpp_adt_scope(plan, "production") if include_machine_targets else None
        spare_scope = mpp_adt_scope(plan, "spare") if include_machine_targets else None
        all_adt_scope = mpp_adt_scope(plan, "all") if include_machine_targets else None
        production_adt_roster = (
            mpp_production_adt_roster(plan) if include_machine_targets else None
        )
        production_availability_fleet_total = (
            len(production_adt_roster) if production_adt_roster is not None else None
        )
        cells = []
        load_times = {}
        for shift in ("Day", "Night"):
            shift_data = summary.build_summary(date, shift, site, plan, assets, breakdowns, by_date[date],
                                               now=now, estimate_availability=False, adt_scope=adt_scope)
            if include_machine_targets:
                production_data = shift_data if adt_scope == production_scope else summary.build_summary(
                    date, shift, site, plan, assets, breakdowns, by_date[date],
                    now=now, estimate_availability=False, adt_scope=production_scope)
                production_hours = production_data["hours"]
            warnings.extend(shift_data["warnings"])
            load_times[shift] = shift_data["excavators"]
            fatigue_warning_start = len(warnings)
            windows = non_working_windows(plan, date, shift, site, fatigue, warnings)

            fatigue_verified = not any(
                "fatigue configuration" in warning.lower()
                or "fatigue periods are unknown" in warning.lower()
                for warning in warnings[fatigue_warning_start:]
            )

            for hour_index, hour in enumerate(shift_data["hours"]):
                colour = category(hour)
                segments, minutes = hour_segments(hour, windows, colour)
                counts["grey"] += minutes / 60
                counts[colour] += 1 - minutes / 60
                missing += int(hour["record_status"] == "missing")
                pending += int(not hour["completed"])
                average_hours = get_average_productive_hours(
                    hour.get("target_bcm"),
                    plan.get("num_excavators"),
                    minutes,
                    verified=fatigue_verified,
                )

                cells.append({key: hour[key] for key in ("label", "start", "end", "actual_bcm", "target_bcm",
                              "achievement", "has_record", "record_status", "excavator_available",
                              "excavator_utilised", "excavator_unavailable", "completed", "available", "utilised")} | {
                                  "category": "grey" if minutes == 60 else colour,
                                  "non_working_minutes": minutes,
                                  "average_productive_hours": average_hours,
                                  "segments": segments
                              })
                if include_machine_targets:
                    production_hour = production_hours[hour_index]
                    cells[-1].update(production_available=production_hour["available"],
                                     production_utilised=production_hour["utilised"])

                    hour_start = datetime.combine(date, time(6)) + timedelta(hours=hour_index)
                    cells[-1]["production_availability_segments"] = (
                        production_adt_availability_segments(
                            production_adt_roster,
                            assets,
                            availability_breakdowns,
                            hour_start,
                            hour_start + timedelta(hours=1),
                            now,
                        )
                    )

        rows.append({"date": date.isoformat(), "day": date.strftime("%a"), "month": date.strftime("%B %Y"),
                     "month_key": date.strftime("%Y-%m"), "plan_name": plan["name"],
                     "fleet_total": fleet_total, "cells": cells, "load_times": load_times,
                     "mpp_daily_target_bcm": mpp_daily_target, "mpp_month_actual_bcm": get_mpp_month_actual(plan)})
        if include_machine_targets:
            rows[-1]["production_fleet_total"] = (
                len(production_scope) if plan.get("excavator_truck_assignments") is not None else None
            )
            rows[-1]["production_availability_fleet_total"] = (
                production_availability_fleet_total
            )
            rows[-1]["fleet_composition"] = {
                "production": production_availability_fleet_total,
                "spare": len(spare_scope) if production_adt_roster is not None else None,
                "total": len(all_adt_scope) if production_adt_roster is not None else None,
            }

    total = len(rows) * 24
    if missing:
        warnings.append(f"{missing} completed hourly cells have no production record. Displayed zero is unverified; missing cells remain in the pie denominator.")
    if pending:
        warnings.append(f"{pending} hourly cells are unfinished or future. They remain in the pie denominator.")
    return {"site": site, "from_date": first.isoformat(), "to_date": last.isoformat(), "rows": rows,
            "hours": [cell["label"] for cell in rows[0]["cells"]], "warnings": list(dict.fromkeys(warnings)),
            "pie": {"total_hours": total, "categories": {key: {"hours": value, "percent": value / total * 100}
                                                        for key, value in counts.items()}},
            "missing_hours": missing, "pending_hours": pending,
            **({"machine_scope": machine_scope} if include_machine_targets else {})}


